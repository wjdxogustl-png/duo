# 복사해서 .env 로 이름을 바꾸고 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# 어떤 LLM을 쓸지: mock(무료, 키 불필요) / claude_agent·claude_cli(로그인한 Claude Code 구독) / gemini(무료 구간) / ollama(내 PC, 무료) / anthropic(Claude API, 유료)
# 비워 두면 Claude 키가 있을 때 anthropic, 없으면 mock 으로 동작합니다.
LLM_PROVIDER=mock

# --- claude_agent / claude_cli: 터미널에서 `claude` 로 로그인돼 있으면 끝. 못 찾으면 경로를 지정하세요.
# CLAUDE_CLI_PATH=C:\Users\내이름\.local\bin\claude.exe
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=180

# --- gemini: https://aistudio.google.com 에서 무료 키 발급 (pip install langchain-google-genai)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- ollama: https://ollama.com 설치 후 `ollama pull qwen3:8b` (pip install langchain-ollama)
OLLAMA_MODEL=qwen3:8b

# --- anthropic: https://platform.claude.com 에서 크레딧 충전 후 키 발급
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
